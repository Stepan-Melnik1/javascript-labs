<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Учёт финансов</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css" />
</head>
<body>

  <header class="site-header">
    <div class="header-inner">
      <div class="logo">₿alance</div>
      <div class="total-block">
        <span class="total-label">Итого</span>
        <span class="total-amount" id="totalAmount">0.00 ₽</span>
      </div>
    </div>
  </header>

  <main class="main-layout">

    <!-- Форма добавления транзакции -->
    <section class="card form-card">
      <h2 class="card-title">Новая транзакция</h2>
      <form id="transactionForm" novalidate>
        <div class="form-grid">
          <div class="field-group">
            <label for="amount">Сумма (₽)</label>
            <input type="number" id="amount" placeholder="например: -500 или 1200" />
            <span class="field-error" id="amountError"></span>
          </div>
          <div class="field-group">
            <label for="category">Категория</label>
            <select id="category">
              <option value="">— выбрать —</option>
              <option value="Доход">💰 Доход</option>
              <option value="Еда">🍕 Еда</option>
              <option value="Транспорт">🚌 Транспорт</option>
              <option value="Развлечения">🎮 Развлечения</option>
              <option value="Здоровье">💊 Здоровье</option>
              <option value="Жильё">🏠 Жильё</option>
              <option value="Одежда">👗 Одежда</option>
              <option value="Прочее">📦 Прочее</option>
            </select>
            <span class="field-error" id="categoryError"></span>
          </div>
          <div class="field-group full-width">
            <label for="description">Описание</label>
            <input type="text" id="description" placeholder="Кратко опишите транзакцию" />
            <span class="field-error" id="descriptionError"></span>
          </div>
        </div>
        <button type="submit" class="btn-add">+ Добавить</button>
      </form>
    </section>

    <!-- Таблица транзакций -->
    <section class="card table-card">
      <h2 class="card-title">История</h2>
      <div class="table-wrapper">
        <table id="transactionsTable">
          <thead>
            <tr>
              <th>Дата и время</th>
              <th>Категория</th>
              <th>Описание</th>
              <th>Сумма</th>
              <th>Действие</th>
            </tr>
          </thead>
          <tbody id="tableBody"></tbody>
        </table>
        <div class="empty-state" id="emptyState">Транзакций пока нет. Добавьте первую!</div>
      </div>
    </section>

    <!-- Подробное описание транзакции -->
    <section class="card detail-card" id="detailCard">
      <h2 class="card-title">Подробнее</h2>
      <div id="transactionDetail" class="detail-content">
        <span class="detail-placeholder">Нажмите на строку в таблице, чтобы увидеть детали.</span>
      </div>
    </section>

  </main>

  <script type="module" src="src/index.js"></script>
</body>
</html>
